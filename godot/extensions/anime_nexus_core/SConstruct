#!/usr/bin/env python

local_env = Environment(tools=["default"], PLATFORM="")
env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7", "env": local_env})
env.Append(CPPPATH=["src/"])

suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
filename = "{}anime_nexus_core{}{}".format(
    env.subst("$SHLIBPREFIX"), suffix, env.subst("$SHLIBSUFFIX")
)
library = env.SharedLibrary(
    "bin/{}/{}".format(env["platform"], filename),
    source=Glob("src/*.cpp"),
)
project_library = env.Install("../../bin/{}".format(env["platform"]), library)
Default(library, project_library)
