[configuration]
entry_symbol = "anime_nexus_core_library_init"
compatibility_minimum = "4.7"

[libraries]
linux.x86_64 = "res://bin/linux/libanime_nexus_core.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libanime_nexus_core.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/android/libanime_nexus_core.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libanime_nexus_core.android.template_release.arm64.so"
